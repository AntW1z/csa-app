rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isModerator() {
      return request.auth != null && (role() == 'moderator' || role() == 'admin');
    }

    function isAdmin() {
      return request.auth != null && role() == 'admin';
    }

    // Anyone signed in can read profiles (needed to show pending requests
    // to moderators). Users can create their own doc on first sign-in and
    // edit their own fields, but cannot change their own role — only a
    // moderator/admin write can do that. Self-delete only, for account
    // deletion (App Store Guideline 5.1.1(v) requires this be possible
    // in-app) — see app/(tabs)/profile.tsx.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && (
        (request.auth.uid == uid && request.resource.data.role == resource.data.role) ||
        isModerator()
      );
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Posts are public to read (no login needed to browse), but only
    // moderators/admins can write. The `featured` flag on a post is what
    // makes it the full-screen launch popup on Home — same rule covers it.
    match /posts/{postId} {
      allow read: if true;
      allow write: if isModerator();
    }

    // Home screen's auto-advancing image carousel — public to read, same
    // as posts, only moderators/admins curate it.
    match /carouselItems/{itemId} {
      allow read: if true;
      allow write: if isModerator();
    }

    // Sponsor promos shown on the Sponsors tab — same trust level as posts
    // and the carousel: public to read, only moderators/admins curate it.
    match /sponsors/{sponsorId} {
      allow read: if true;
      allow write: if isModerator();
    }

    // Drafted/sent push notifications, managed from Manage > Notifications.
    // Only moderators can draft, edit, or send one — but once a message is
    // actually sent, any signed-in user can read it for their in-app inbox
    // (app/(tabs)/notifications.tsx). Drafts stay moderator/admin-only.
    // Audience ("everyone" vs "members") is filtered client-side, same
    // accepted tradeoff as posts' members-only visibility — see README.
    match /notifications/{notifId} {
      allow read: if isModerator() || (request.auth != null && resource.data.status == 'sent');
      allow write: if isModerator();
    }

    // Moderation audit log. Moderators' actions still get logged (they can
    // create entries), but only an admin can read or clear the log itself —
    // moderators can't browse each other's history.
    match /logs/{logId} {
      allow read: if isAdmin();
      allow create: if isModerator();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Bug reports/suggestions from the "What is CSA?" popup in Profile.
    // Anyone signed in can submit one (and must submit it as themselves,
    // not spoof another uid), but only moderators can read the list or
    // mark one reviewed — this isn't public content like posts/sponsors.
    match /feedback/{feedbackId} {
      allow read: if isModerator();
      allow create: if request.auth != null && request.resource.data.submittedByUid == request.auth.uid;
      allow update: if isModerator();
      allow delete: if isModerator();
    }
  }
}
